@article{worley_performance_2005,
	title = {Performance {Portability} in the {Physical} {Parameterizations} of the {Community} {Atmospheric} {Model}},
	volume = {19},
	copyright = {https://journals.sagepub.com/page/policies/text-and-data-mining-license},
